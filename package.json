{
  "name": "@beremaran/opencode-subagent-throttle",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "OpenCode plugin that limits concurrent task and subagent calls with FIFO queueing.",
  "type": "module",
  "sideEffects": false,
  "main": "./index.ts",
  "types": "./src/v2.ts",
  "exports": {
    ".": {
      "types": "./src/v2.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./src/index.ts",
      "default": "./src/v1.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/beremaran/opencode-subagent-throttle",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-subagent-throttle/issues"
  },
  "engines": {
    "node": ">=22.6",
    "opencode": ">=1.18.11 <3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "lint": "biome check src test",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "task",
    "subagent",
    "concurrency",
    "queue",
    "throttle"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-subagent-throttle.git"
  },
  "license": "MIT",
  "funding": {
    "github": "beremaran"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.11 <2"
  },
  "dependencies": {
    "@opencode-ai/sdk": ">=1.18.11 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@opencode-ai/plugin": "1.18.30",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
