{
  "name": "@beremaran/opencode-subagent-throttle",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "OpenCode plugin that throttles concurrent task/subagent tool calls by queueing them as pending (never rejecting).",
  "type": "module",
  "sideEffects": false,
  "main": "./src/v1.ts",
  "types": "./src/v2.ts",
  "exports": {
    ".": {
      "types": "./src/v2.ts",
      "default": "./src/v2.ts"
    },
    "./server": {
      "types": "./src/index.ts",
      "default": "./src/v1.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/beremaran/opencode-subagent-throttle",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-subagent-throttle/issues"
  },
  "engines": {
    "node": ">=22.6",
    "opencode": ">=1.18.11 <3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "lint": "biome check src test",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagent",
    "throttle",
    "queue",
    "concurrency"
  ],
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-subagent-throttle.git"
  },
  "license": "MIT",
  "funding": {
    "github": "beremaran"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.11 <2"
  },
  "dependencies": {
    "@opencode-ai/sdk": ">=1.18.11 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@opencode-ai/plugin": "1.18.15",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
